{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "fix": {
          "imports": "safe-fix",
          "variables": "off"
        }
      }
    ]
  },
  "ignorePatterns": ["node_modules", ".moon", "dist", ".git", "apps/docs/src/routeTree.gen.ts"],
  "env": {
    "builtin": true
  }
}
