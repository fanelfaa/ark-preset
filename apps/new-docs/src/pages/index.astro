---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '@ark-preset/core';
import { H2, P, InlineCode } from '@ark-preset/solid';

const categories = [
  { name: "Form & Input", count: 19, href: "/solid/components/button", description: "Button, Input, Select, Checkbox, Switch, and more" },
  { name: "Overlay", count: 8, href: "/solid/components/dialog", description: "Dialog, Drawer, Popover, Tooltip, Toast, and more" },
  { name: "Navigation", count: 6, href: "/solid/components/accordion", description: "Accordion, Breadcrumb, Tabs, Menu, Pagination" },
  { name: "Data Display", count: 6, href: "/solid/components/card", description: "Card, Table, Avatar, Badge, Carousel, Typography" },
  { name: "Feedback", count: 4, href: "/solid/components/alert", description: "Alert, Progress, Skeleton, Spinner" },
  { name: "Layout", count: 3, href: "/solid/components/scroll-area", description: "Scroll Area, Separator, Aspect Ratio" },
];

const totalCount = categories.reduce((sum, cat) => sum + cat.count, 0);

const quickLinks = [
  { href: "/solid/components/button", label: "Button" },
  { href: "/solid/components/input", label: "Input" },
  { href: "/solid/components/dialog", label: "Dialog" },
  { href: "/solid/components/select", label: "Select" },
  { href: "/solid/components/toast", label: "Toast" },
  { href: "/solid/components/tabs", label: "Tabs" },
  { href: "/solid/components/accordion", label: "Accordion" },
  { href: "/solid/components/card", label: "Card" },
];
---
<Layout currentFramework="solid" isHome={true}>
  <div class="mx-auto max-w-4xl px-6 py-12 min-h-screen bg-background/30 backdrop-blur-3xl">
    {/* Hero */}
    <section class="mb-16 text-center">
      <h1 class="mb-4 text-5xl font-bold tracking-tight">UI Component Library</h1>
      <P>
        A comprehensive collection of accessible, composable UI primitives built with{" "}
        <InlineCode>Ark UI</InlineCode> and <InlineCode>Solid.js</InlineCode>. Ready to use, fully
        typed, and styled with Tailwind CSS.
      </P>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a
          href="/solid/components/button"
          class={buttonVariants({ size: "lg" })}
        >
          Browse Components
        </a>
        <span class="text-sm text-muted-foreground">
          {totalCount} components across {categories.length} categories
        </span>
      </div>
    </section>

    {/* Quick Start */}
    <section class="mb-16 text-center">
      <H2>Quick Start</H2>
      <P class="mb-6">
        Follow the step-by-step guide to add <InlineCode>@ark-preset/solid</InlineCode> to your
        project.
      </P>
      <a href="/setup" class={buttonVariants({ size: "lg" })}>
        View Quickstart Guide
      </a>
    </section>

    {/* Component Categories */}
    <section class="mb-16">
      <H2>Components</H2>
      <div class="grid gap-4 sm:grid-cols-2">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="group rounded-lg border border-border p-5 transition-colors hover:border-primary bg-background/50 backdrop-blur-sm hover:bg-background/70"
          >
            <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
              {cat.name}
            </h3>
            <p class="mt-1 text-sm text-muted-foreground">{cat.description}</p>
            <p class="mt-2 text-xs text-muted-foreground">{cat.count} components</p>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a
          href="/solid/components/button"
          class={buttonVariants({ variant: "outline" })}
        >
          View All Components
        </a>
      </div>
    </section>

    {/* Quick Links */}
    <section>
      <H2>Popular Components</H2>
      <div class="flex flex-wrap gap-3">
        {quickLinks.map((link) => (
          <a href={link.href} class={buttonVariants({ variant: "outline" })}>
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
