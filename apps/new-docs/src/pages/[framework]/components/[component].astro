---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { DocsLayout } from '../../../components/DocsLayout';

export async function getStaticPaths() {
  const frameworks = ['solid', 'react', 'vue'];
  let paths = [];

  for (const framework of frameworks) {
    const entries = await getCollection(framework as any);
    for (const entry of entries) {
      paths.push({
        params: { framework, component: entry.id },
        props: { entry },
      });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout currentFramework={Astro.params.framework}>
  <div class="px-6 py-8">
    <Content />
  </div>
  <script is:inline>
    document.addEventListener('change', (e) => {
      if (e.target && e.target.id === 'framework-selector') {
        const newFramework = e.target.value;
        const path = window.location.pathname;
        let newPath = path;
        if (path.startsWith('/solid/') || path.startsWith('/react/') || path.startsWith('/vue/')) {
          newPath = path.replace(/^\/(solid|react|vue)/, `/${newFramework}`);
        } else if (path.includes('/components/')) {
          newPath = `/${newFramework}${path.replace(/^\/docs/, '')}`;
        } else {
          newPath = `/${newFramework}/components/button`;
        }
        window.location.href = newPath;
      }
    });
  </script>
</Layout>
