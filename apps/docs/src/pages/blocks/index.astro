---
import Layout from '../../layouts/Layout.astro';
import { Heading, TextLead, TextMuted } from '@ark-preset/solid';
---

<Layout>
  <div class="max-w-4xl mx-auto py-10 space-y-8">
    <div>
      <Heading level={1} class="mb-2">Blocks</Heading>
      <TextLead>
        Ready-made, copy-pasteable component compositions to help you build your application faster.
      </TextLead>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      <a href="/blocks/auth" class="group block p-6 border rounded-xl hover:border-primary transition-colors bg-card text-card-foreground shadow-sm">
        <Heading level={3} class="mb-2 group-hover:text-primary transition-colors">Authentication</Heading>
        <TextMuted>
          Login and registration forms, available in card, modal, and split-screen layouts.
        </TextMuted>
      </a>
      
      {/* Add more block categories here in the future */}
      <div class="block p-6 border rounded-xl border-dashed bg-muted/30 text-muted-foreground shadow-sm">
        <Heading level={3} class="mb-2">More coming soon</Heading>
        <TextMuted class="text-inherit">
          Dashboards, settings pages, e-commerce layouts, and more.
        </TextMuted>
      </div>
    </div>
  </div>
</Layout>
